# MySQL Datenbank-Konfiguration für die TodoList-App
# Diese Datei ist optional - Standardwerte sind bereits in application.properties definiert

# Root-Passwort für MySQL
MYSQL_ROOT_PASSWORD=root

# Datenbankname
MYSQL_DATABASE=todo_db

# App-User für TodoList
MYSQL_USER=todouser
MYSQL_PASSWORD=todopass123
